# ──────────────────────────────────────────────────────────────────────────────
# AreaFada OS — API Server environment variables
# Copy this file to .env and fill in the values (never commit .env to git).
# In Replit, set secrets via the Secrets tab; env vars via the Environment tab.
# ──────────────────────────────────────────────────────────────────────────────

# ── Clerk (auth) ──────────────────────────────────────────────────────────────
# Publishable key — safe to expose to the browser (starts with pk_)
CLERK_PUBLISHABLE_KEY=pk_test_...

# Secret key — server-side only, never expose to the browser (starts with sk_)
CLERK_SECRET_KEY=sk_test_...

# Webhook signing secret — obtained from Clerk dashboard → Webhooks → your endpoint
# Required for POST /api/webhooks/clerk to accept events (starts with whsec_)
# Register the endpoint at: https://www.areafadaos.com/api/webhooks/clerk
# Subscribe to events: user.created, session.created
CLERK_WEBHOOK_SECRET=whsec_...

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (auto-provisioned in Replit)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Enterprise overrides ──────────────────────────────────────────────────────
# Comma-separated list of emails that always receive the "enterprise" tier
ENTERPRISE_EMAILS=owner@example.com
